# ===== TikTok =====
# Kênh để lắng nghe tim / bình luận / quà (không cần @)
TIKTOK_USERNAME=
# (tuỳ chọn) API key Euler Stream nếu hay bị lỗi ký/giới hạn khi kết nối
SIGN_API_KEY=

# Mật khẩu trang admin: mở http://localhost:8686/admin?token=...
ADMIN_TOKEN=doi-mat-khau-nay

# ===== Phát live (RTMP) =====
# Lấy trong TikTok LIVE Studio / LIVE Producer: "Server URL" và "Stream Key"
STREAM_SERVER=
STREAM_KEY=

# Giao diện phát: chanhdien hoặc overlay (xây chùa)
PAGE=chanhdien

# Chất lượng. VPS yếu (2 vCPU) dùng 720x1280, 2500k
STREAM_WIDTH=1080
STREAM_HEIGHT=1920
STREAM_FPS=30
VIDEO_BITRATE=4500k
X264_PRESET=veryfast
