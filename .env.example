# ===== TikTok =====
# Kênh để lắng nghe tim / bình luận / quà (không cần @)
TIKTOK_USERNAME=
# (tuỳ chọn) API key Euler Stream nếu hay bị lỗi ký/giới hạn khi kết nối
SIGN_API_KEY=

# Mật khẩu trang admin (ít nhất 12 ký tự): mở .../admin?token=...
ADMIN_TOKEN=doi-mat-khau-nay

# ===== HTTPS cho điện thoại (Docker profile "https") =====
# Tên miền riêng đã trỏ về IP VPS, hoặc tên miền miễn phí dạng 103-82-27-60.sslip.io
DOMAIN=

# ===== Phát live (RTMP) =====
# Lấy trong TikTok LIVE Studio / LIVE Producer: "Server URL" và "Stream Key"
STREAM_SERVER=
STREAM_KEY=

# Trang được phát khi VPS tự phát live (chế độ stream)
PAGE=doantu

# Chất lượng. VPS yếu (2 vCPU) dùng 720x1280, 2500k
STREAM_WIDTH=1080
STREAM_HEIGHT=1920
STREAM_FPS=30
VIDEO_BITRATE=4500k
X264_PRESET=veryfast

# ===== Game đoán từ (/doantu) =====
# API key Claude để chấm độ gần nghĩa (https://console.anthropic.com). Không có thì chấm đơn giản theo chữ.
ANTHROPIC_API_KEY=
# Phố Mới (/city): hộp thư thị trưởng dùng chung ANTHROPIC_API_KEY ở trên để Claude viết tình huống, đàm phán, đánh giá du khách.
# Không có key thì game dùng lời soạn sẵn. Model mặc định claude-opus-5-5; đặt claude-haiku-5-5 nếu muốn rẻ hơn.
CITY_AI_MODEL=
# Số lượt gọi Claude tối đa mỗi ngày cho cả server (mặc định 3000); mỗi máy tối đa 12 lượt / phút.
CITY_AI_DAILY=

# Giọng MC đọc câu chúc mừng / cảm ơn trêu đùa (ElevenLabs).
# Lấy key ở elevenlabs.io → Profile → API Keys. Để trống = trình duyệt tự đọc tên như cũ.
ELEVENLABS_API_KEY=
# (tuỳ chọn) đổi model chấm điểm, mặc định claude-opus-5-5
WORDGAME_MODEL=
# (tuỳ chọn) đổi model sinh lô từ bí mật (100 từ/lô), mặc định claude-opus-5-5
WORDGAME_GEN_MODEL=
