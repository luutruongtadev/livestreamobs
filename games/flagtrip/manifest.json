      "defaultTriggers": [
        {
          "type": "gift",
          "giftName": "Hat and Mustache"
        }
      ]
    },
    {
      "id": "jet",
      "label": "Phản lực: tiến 5 chặng",
      "icon": "🚀",
      "defaultTriggers": [
        {
          "type": "gift",
          "giftName": "Money Gun"
        }
      ]
    }
  ],
  "commands": [
    {
      "id": "next",
      "label": "Bước tiếp"
    },
    {
      "id": "skip",
      "label": "Đổi cờ"
    },
    {
      "id": "new-trip",
      "label": "Chuyến bay mới"
    },
    {
      "id": "clear-board",
      "label": "Xoá bảng điểm"
    }
  ],
  "panels": [
    {
      "id": "gifts",
