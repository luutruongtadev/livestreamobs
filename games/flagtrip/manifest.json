      "event": "nobody",
      "q": "confused travolta",
      "sound": {
        "mode": "lib",
        "id": "crickets"
      },
      "text": "Cờ gì đây trời?|Không ai biết luôn 😶|Đi học địa lý lại thôi"
    },
    {
      "event": "fall",
      "q": "plane crash fail",
      "sound": {
        "mode": "lib",
        "id": "sadtrombone"
      },
      "text": "Máy bay rớt rồi!|Quay về điểm mốc 😭"
    },
    {
      "event": "rescued",
      "q": "hero save",
      "sound": {
        "mode": "lib",
        "id": "fanfare"
      },
      "text": "Cứu kịp rồi!|Anh hùng xuất hiện 🦸"
    },
    {
      "event": "landed",
      "q": "landing celebration",
      "sound": {
        "mode": "lib",
        "id": "applause"
      },
      "text": "Hạ cánh an toàn!|Chuyến bay tuyệt vời ✈️"
    }
  ]
