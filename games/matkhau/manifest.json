{
  "id": "matkhau",
  "name": "Mật Khẩu Lầy",
  "description": "Đặt mật khẩu mới thoả một chuỗi luật oái oăm hiện dần (cộng số, tên món ăn, giờ hiện tại, cấm chữ…). Host tự gõ hoặc người xem tự chơi bằng bình luận. Khán giả bình chọn luật, ra luật bằng bình luận, tặng quà để phá (hacker, mèo, cấm chữ) hoặc cứu (gợi ý, thêm giờ, xoá luật).",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "status": "beta",
  "category": "party",
  "thumbnail": "assets/thumb.svg",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "inputs": [
    "comment"
  ],
  "restore": "full",
  "server": true,
  "play": true,
  "data": {
    "lines": "data/lines.json"
  },
