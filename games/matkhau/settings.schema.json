{
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "title": "Ai chơi",
      "enum": [
        "host",
        "viewer"
      ],
      "enumNames": [
        "Host tự gõ trong cửa sổ chơi",
        "Người xem tự chơi: gõ mật khẩu vào bình luận"
      ],
      "default": "host"
    },
    "startLevel": {
      "type": "integer",
      "title": "Màn bắt đầu",
      "minimum": 1,
      "maximum": 30,
      "default": 1
    },
    "baseRules": {
      "type": "integer",
      "title": "Số luật ở màn 1",
      "minimum": 3,
      "maximum": 14,
      "default": 6
    },
    "rulesPerLevel": {
      "type": "integer",
      "title": "Mỗi màn thêm mấy luật",
      "minimum": 0,
      "maximum": 3,
      "default": 1
    },
    "maxRules": {
      "type": "integer",
      "title": "Tối đa số luật / màn",
      "minimum": 4,
      "maximum": 20,
      "default": 14
    },
    "baseSeconds": {
      "type": "integer",
      "title": "Thời gian gốc mỗi màn (giây)",
      "minimum": 30,
      "maximum": 900,
      "default": 90
    },
    "secondsPerRule": {
      "type": "integer",
      "title": "Thêm giây cho mỗi luật",
      "minimum": 0,
      "maximum": 120,
      "default": 20
    },
    "introSeconds": {
      "type": "integer",
      "title": "Thời gian giới thiệu màn (giây)",
      "minimum": 2,
      "maximum": 30,
      "default": 6
    },
    "resultSeconds": {
      "type": "integer",
      "title": "Thời gian màn kết quả (giây)",
      "minimum": 3,
      "maximum": 60,
      "default": 10
    },
    "voteEvery": {
      "type": "integer",
      "title": "Cứ mấy luật thì khán giả bình chọn 1 luật (0 = tắt)",
      "minimum": 0,
      "maximum": 10,
      "default": 4
    },
    "voteSeconds": {
      "type": "integer",
      "title": "Thời gian bình chọn (giây)",
      "minimum": 5,
      "maximum": 60,
      "default": 12
    },
    "viewerRuleEvery": {
      "type": "integer",
      "title": "Cứ mấy luật thì lấy 1 từ trong bình luận làm luật (0 = tắt)",
      "minimum": 0,
      "maximum": 10,
      "default": 3
    },
    "raluatSeconds": {
      "type": "integer",
      "title": "Quà Ra luật: thời gian chờ người tặng gõ từ (giây)",
      "minimum": 5,
      "maximum": 60,
      "default": 20
    },
    "aiRules": {
      "type": "boolean",
      "title": "Người xem đặt luật bằng lời bất kỳ, AI duyệt và tự kiểm tra (cần ANTHROPIC_API_KEY trên máy chủ; tắt = luật chỉ là 1 từ)",
      "default": true
    },
    "freeRules": {
      "type": "boolean",
      "title": "Ai cũng ra luật được: bình luận bắt đầu bằng “luật:” (không cần quà)",
      "default": true
    },
    "freeRulesPerLevel": {
      "type": "integer",
      "title": "Tối đa luật “luật:” miễn phí mỗi màn",
      "minimum": 0,
      "maximum": 10,
      "default": 3
    },
    "ruleCooldownSeconds": {
      "type": "integer",
      "title": "Mỗi người chờ bao lâu mới ra luật miễn phí tiếp (giây)",
      "minimum": 0,
      "maximum": 600,
      "default": 90
    },
    "cutSeconds": {
      "type": "integer",
      "title": "Quà Rút giờ: bớt mấy giây",
      "minimum": 5,
      "maximum": 120,
      "default": 20
    },
    "addSeconds": {
      "type": "integer",
      "title": "Quà Thêm giờ: thêm mấy giây",
      "minimum": 5,
      "maximum": 180,
      "default": 30
    },
    "hostName": {
      "type": "string",
      "title": "Tên chủ phòng (dùng cho luật “có tên chủ phòng”, để trống = không dùng)",
      "maxLength": 30,
      "default": ""
    },
    "tzOffset": {
      "type": "integer",
      "title": "Múi giờ cho luật giờ / thứ / năm (giờ lệch UTC)",
      "minimum": -12,
      "maximum": 14,
      "default": 7
    },
    "dropLevelOnFail": {
      "type": "boolean",
      "title": "Hết giờ thì lùi 1 màn",
      "default": true
    },
    "punishment": {
      "type": "string",
      "title": "Hết giờ thì phạt gì",
      "enum": [
        "game",
        "voice",
        "off"
      ],
      "enumNames": [
        "Án phạt trong game: màn sau khó hơn (không cần camera)",
        "Phạt bằng giọng nói qua micro (hát, đọc to…)",
        "Không phạt"
      ],
      "default": "game"
    },
    "bannedWords": {
      "type": "string",
      "title": "Từ cấm khi lấy từ bình luận làm luật (cách nhau dấu phẩy)",
      "maxLength": 1000,
      "default": "đm, dm, địt, đjt, lồn, cặc, đéo, vcl, vkl, clm, đĩ, óc chó"
    }
  }
}