{
  "id": "memory",
  "name": "Nhớ số",
  "description": "Một dãy số hiện lên rồi biến mất — người xem gõ lại đúng dãy số vào bình luận. Trả lời càng nhanh càng nhiều điểm, mỗi cấp dãy số dài thêm.",
  "version": "1.2.0",
  "sdk": "^1.0.0",
  "status": "live",
  "category": "puzzle",
  "thumbnail": "assets/thumb.svg",
  "canvas": {
    "width": 1080,
    "height": 1920
  },
  "inputs": [
    "comment"
  ],
  "restore": "full",
  "server": false,
  "actions": [
    {
      "id": "flash",
      "label": "Hiện lại dãy số",
      "icon": "👀",
      "defaultTriggers": [
        {
          "type": "gift",
          "giftName": "Rose"
        }
      ]
    },
    {
      "id": "digit",
      "label": "Lộ 1 chữ số",
      "icon": "🔍",
      "defaultTriggers": [
        {
          "type": "gift",
          "giftName": "Finger Heart"
        }
      ]
    },
    {
      "id": "time",
      "label": "+3 giây trả lời",
      "icon": "⏱️",
      "defaultTriggers": [
        {
          "type": "like",
          "every": 300
        }
      ]
    },
    {
      "id": "shield",
      "label": "Khiên giữ cấp",
      "icon": "🛡️",
      "defaultTriggers": [
        {
          "type": "gift",
          "giftName": "Doughnut"
        }
